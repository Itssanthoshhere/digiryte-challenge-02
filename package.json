{
  "name": "digiryte-challenge-02",
  "version": "1.0.0",
  "description": "Distributed Real-Time Sync - Collaborative Kanban Board",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "server1": "PORT=3001 SERVER_ID=server-1 node server.js",
    "server2": "PORT=3002 SERVER_ID=server-2 node server.js",
    "lb": "node load-balancer.js",
    "client:dev": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",
    "build": "npm --prefix client run build",
    "vercel-build": "npm --prefix client install && npm --prefix client run build"
  },
  "keywords": [
    "socket.io",
    "redis",
    "mongodb",
    "real-time",
    "collaborative"
  ],
  "author": "Santhosh VS",
  "license": "MIT",
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "http-proxy": "^1.18.1",
    "mongoose": "^8.6.0",
    "redis": "^4.7.0",
    "socket.io": "^4.7.5"
  }
}
